# analytics-сервис — cross-platform analytics для VIRA.
# Скопировать в .env.analytics и заполнить.

# Auth-токен для входящих запросов (от shell). Тем же токеном сервис
# по умолчанию ходит в publisher (если PUBLISHER_TOKEN не задан).
ANALYTICS_TOKEN=dev-analytics-token-change-me

DB_DIR=/db

# Publisher — analytics читает публикации НАПРЯМУЮ (НЕ через shell), порт 8000,
# путь /publisher/publications. Заголовок X-Worker-Token = PUBLISHER_TOKEN.
PUBLISHER_URL=http://publisher:8000
PUBLISHER_TOKEN=

# Если 1 — fetcher всегда использует mock-фикстуры публикаций (dev без publisher).
ANALYTICS_USE_MOCK=0

# Токены площадок для реальных метрик. Без любого из них соответствующий
# адаптер пишет детерминированные mock-метрики (dev без ключей).
# VK: video.get.
VK_TOKEN=
# Telegram Bot API: getChatMemberCount (размер аудитории канала).
TELEGRAM_BOT_TOKEN=
# YouTube Data API v3 (публичный ключ): videos.list statistics.
YOUTUBE_API_KEY=
# Pinterest API v5 (Bearer): /v5/pins/{id}/analytics.
PINTEREST_TOKEN=

# Воркер-интервалы (секунды). По умолчанию: fetch раз в час, проверка
# daily-snapshot раз в 5 минут (snapshot в 00:00 МСК).
FETCH_INTERVAL_SECONDS=3600
SNAPSHOT_CHECK_SECONDS=300

# Запускать фоновый fetcher в lifespan (в тестах — 0).
ENABLE_FETCHER=1
