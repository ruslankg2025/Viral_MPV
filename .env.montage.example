# ── montage (автомонтаж) — образец. Реальный .env.montage НЕ коммитить. ──
# Токен для входящих запросов от shell-прокси (X-Worker-Token). Должен совпадать
# с MONTAGE_TOKEN в окружении shell.
MONTAGE_TOKEN=change-me-worker-token

# Пути внутри контейнера (совпадают с томами в docker-compose.prod.yml).
DB_DIR=/db
WORK_DIR=/montage
OPENMONTAGE_ROOT=/opt/OpenMontage

# Ночное окно (локальное время контейнера, TZ). Джоб СТАВИТСЯ в любое время, но
# СТАРТУЕТ только в окне — если не задан force. Память проверяется всегда.
NIGHT_ENABLED=true
NIGHT_START_HOUR=1
NIGHT_END_HOUR=7

# Мин. MemAvailable всей машины (МБ) для старта джоба. Ниже — воркер ждёт.
MIN_AVAIL_MB=2500
# Жёсткий таймаут джоба (сек) и потолок потоков CPU (бережём соседей).
JOB_TIMEOUT_SEC=5400
CPU_THREADS=2

# Дефолты рендера
DEFAULT_MODEL=base
DEFAULT_WIDTH=2160
DEFAULT_HEIGHT=3840
DEFAULT_LANGUAGE=ru

# Загрузка/диск. MAX_UPLOAD_MB держать ≤ nginx client_max_body_size (сейчас
# 320M на проде) — для мультикама поднимать и nginx, и это значение.
MAX_UPLOAD_MB=300
RESULT_TTL_HOURS=72

# Часовой пояс контейнера (важно для ночного окна). Прод — Europe/Moscow.
TZ=Europe/Moscow

# Pexels — для B-roll (фаза A5). Ключ уже есть в OpenMontage/.env на проде;
# при рендере в контейнере передать сюда (raw-key, без Bearer).
# PEXELS_API_KEY=
