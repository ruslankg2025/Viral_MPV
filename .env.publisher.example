# viral-publisher — пример конфига (автопостинг роликов на площадки)
# Скопировать в .env.publisher и заполнить. Реальный .env.publisher в .gitignore.

# ── Сервисные токены (авторизация входящих запросов от shell) ──
# sync-env.sh сгенерирует PUBLISHER_TOKEN автоматически, если оставить change-me.
PUBLISHER_TOKEN=change-me-worker-token
PUBLISHER_ADMIN_TOKEN=change-me-admin-token

DB_DIR=/db
MEDIA_DIR=/media

# По умолчанию публикуем в DRY-RUN (без реальных постов). Снять после проверки.
DEFAULT_DRY_RUN=1

# ── VK (активна) ──
# Токен доступа VK (community/user) с правами video + wall.
VK_ACCESS_TOKEN=
VK_API_VERSION=5.199
# owner_id/group_id (с минусом для группы, напр. -123456789).
VK_GROUP_ID=

# ── Telegram (активна) ──
# Токен бота (@BotFather) + id канала (@username или -100…). Бот — админ канала.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# ── YouTube Shorts (пока не активна — подключим позже) ──
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ── Pinterest (пока не активна) ──
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REFRESH_TOKEN=
PINTEREST_BOARD_ID=
# Residential-прокси для РФ-ограниченных площадок (Pinterest). Пусто — без прокси.
HTTP_PROXY=

# ── Планирование / анти-спам ──
SCHEDULE_SPREAD_STEP_MIN=15
SCHEDULE_SPREAD_JITTER_MIN=15
ANTISPAM_RATE_WINDOW_HOURS=4
ANTISPAM_RATE_LIMIT=3
ANTISPAM_CONTENT_COOLDOWN_HOURS=24
