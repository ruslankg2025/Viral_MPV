# viral-publisher — пример конфига
# Скопировать в .env.publisher и заполнить.

# ============================================================================
# Сервисные токены (входящие запросы от shell)
# ============================================================================
PUBLISHER_TOKEN=change-me-worker-token
PUBLISHER_ADMIN_TOKEN=change-me-admin-token

DB_DIR=/db
MEDIA_DIR=/media

# ============================================================================
# DRY-RUN (КРИТИЧНО)
# ============================================================================
# true  → НИКАКИХ HTTP к api.vk.com; публикации создаются со status='dry_run'
#         и external_id='dry-run-<uuid>'. Безопасный режим по умолчанию.
# false → live-публикация в VK (требует валидный VK_ACCESS_TOKEN).
# Phase 1 / staging — держать true.
DEFAULT_DRY_RUN=true

# ============================================================================
# VK API (нужно только для live, т.е. при DEFAULT_DRY_RUN=false)
# ============================================================================
# Токен доступа VK (user или community) с правами video, wall.
VK_ACCESS_TOKEN=
# Версия VK API.
VK_API_VERSION=5.199
# id группы для публикации на стену сообщества (без минуса). Пусто → на стену юзера.
VK_GROUP_ID=
