# viral-carousel — пример конфига
# Скопировать в .env.carousel и заполнить.

# ============================================================================
# Сервисные переменные
# ============================================================================
CAROUSEL_TOKEN=change-me-worker-token
CAROUSEL_ADMIN_TOKEN=change-me-admin-token

# Fernet master key. Сгенерировать:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CAROUSEL_KEY_ENCRYPTION_KEY=

DB_DIR=/db
MEDIA_DIR=/media

# Дефолтный провайдер text generation (resolver выберет из активных ключей).
DEFAULT_TEXT_PROVIDER=anthropic_claude_text

# Если 1 — LLM-адаптация выключена, используется fallback-сплиттер (dev без ключей).
CAROUSEL_FAKE_LLM=0

# ============================================================================
# Bootstrap AI-ключей (опционально, вставляются в keys.db при первом старте).
# Если пусто — добавляйте вручную через POST /carousel/admin/api-keys.
# ============================================================================
BOOTSTRAP_ANTHROPIC_API_KEY=
BOOTSTRAP_OPENAI_API_KEY=
